---
const items = [
  { label: "Impact", href: "#impact" },
  { label: "Stack", href: "#skills" },
  { label: "Experience", href: "#experience" },
  { label: "Building", href: "#building" },
  { label: "Contact", href: "#contact" },
];
---

<header
  class="sticky top-0 z-20 border-b border-border bg-bg/70 backdrop-blur-md"
>
  <div class="mx-auto flex h-15 max-w-3xl items-center justify-between px-6">
    <span class="font-mono font-bold tracking-tight">
      hesham<span class="text-accent">.</span>meneisi
    </span>
    <nav class="hidden gap-6 text-sm sm:flex">
      {items.map((i) => (
        <a href={i.href} class="text-muted transition-colors hover:text-ink">
          {i.label}
        </a>
      ))}
    </nav>
  </div>
</header>
